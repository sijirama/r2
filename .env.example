# ── Cloudflare R2 credentials ────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values, then run `make install`.

# Your Cloudflare account ID.
# Find it: Cloudflare dashboard → R2 → Overview → "Account ID" (right sidebar).
R2_ACCOUNT_ID=

# An R2 API token (S3-compatible Access Key + Secret).
# Create it: Cloudflare dashboard → R2 → "Manage R2 API Tokens" → Create API Token
#   → permission "Object Read & Write" (or Admin if you want create/delete buckets)
#   → Create. Cloudflare shows the Access Key ID and Secret Access Key ONCE.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OPTIONAL — enables real permanent "public links".
# Without it, every copied link is a presigned URL that expires in 7 days.
# Create it: Cloudflare dashboard → My Profile → API Tokens → Create Token
#   → use template "Read all resources", OR a custom token with permission
#     Account → "Workers R2 Storage" → Read. Scope it to your account.
CF_API_TOKEN=

# OPTIONAL — port for the local UI (default 8787).
PORT=8787
